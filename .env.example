# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed User IDs (comma-separated, leave empty to allow everyone)
# Find your user_id by sending /start to the bot
ALLOWED_USER_IDS=123456789,987654321

# USDA FoodData Central API Key (optional - uses DEMO_KEY if not provided)
# Get your free API key at: https://fdc.nal.usda.gov/api-key-signup.html
# DEMO_KEY has a limit of 30 requests per hour
USDA_API_KEY=your_usda_api_key_here

# Google Gemini API Key (optional - enables quick meal registration)
# Get your free API key at: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1500 requests/day
# If not provided, users must use /new_meal command for registration
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Panel Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_SECRET_KEY=change_this_secret_key_to_random_string
ADMIN_PORT=5000
