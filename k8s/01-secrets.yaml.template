# Secrets: Stores sensitive data (tokens, passwords, API keys)
# IMPORTANTE: Questo è un TEMPLATE! NON committare con valori reali!
# 
# Come usarlo:
# 1. Copia questo file: cp 01-secrets.yaml 01-secrets-real.yaml
# 2. Aggiungi 01-secrets-real.yaml a .gitignore
# 3. Sostituisci i valori con quelli reali codificati in base64
#
# Come codificare in base64:
#   echo -n "il_tuo_valore" | base64
#
# Esempio:
#   echo -n "123456789:ABCdefGHIjklMNOpqrsTUVwxyz" | base64
#
apiVersion: v1
kind: Secret
metadata:
  name: food-diary-secrets
  namespace: food-diary
type: Opaque
data:
  # TELEGRAM_BOT_TOKEN: Echo del tuo token in base64
  # Esempio: MTIzNDU2Nzg5OkFCQ2RlZkdISWprbE1OT3BxcnNUVVZ3eHl6
  telegram-bot-token: "REPLACE_WITH_BASE64_TOKEN"
  
  # USDA_API_KEY (opzionale)
  usda-api-key: "REPLACE_WITH_BASE64_KEY_OR_REMOVE"
  
  # GEMINI_API_KEY (opzionale)
  gemini-api-key: "REPLACE_WITH_BASE64_KEY_OR_REMOVE"
  
  # Admin credentials
  admin-username: "REPLACE_WITH_BASE64_USERNAME"
  admin-password: "REPLACE_WITH_BASE64_PASSWORD"
  admin-secret-key: "REPLACE_WITH_BASE64_SECRET"
